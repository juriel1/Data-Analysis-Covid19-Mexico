	column 'Día Semana'
		lineageTag: 8db5c62a-f3ae-4ff5-8c33-f1a7b47dbff9
		summarizeBy: none
		isNameInferred
		sourceColumn: [Día Semana]

		annotation SummarizationSetBy = Automatic

	partition Dim_Calendario = calculated
		mode: import
		source =
				
				VAR FechaInicio = DATE(2020, 1, 1)
				VAR FechaFin = DATE(2024, 12, 31)
				RETURN
				ADDCOLUMNS (
				    CALENDAR(FechaInicio, FechaFin),
				    "Año", YEAR([Date]),
				    "Mes Nro", MONTH([Date]),
				    "Mes", FORMAT([Date], "MMMM", "es-MX"),
				    "Trimestre", "T" & QUARTER([Date]),
				    "Día Semana", FORMAT([Date], "dddd", "es-MX")
				)

	annotation PBI_Id = d123fc99dcd64a55ab278ee24826e605

