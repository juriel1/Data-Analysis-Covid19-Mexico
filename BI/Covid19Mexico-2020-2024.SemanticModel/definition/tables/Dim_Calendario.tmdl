table Dim_Calendario
	lineageTag: a76f2133-e339-4a72-8169-28dbcb5a32bc

	column Date
		formatString: General Date
		lineageTag: cc2748b7-02ba-415e-a9c6-0ac2a166941f
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		variation Variación
			isDefault
			relationship: 010b89c8-bb23-4754-b461-03dac60e6f36
			defaultHierarchy: LocalDateTable_24d45067-071b-4dba-afdb-0c989dafb1d7.'Jerarquía de fechas'

		annotation SummarizationSetBy = Automatic

	column Año
		formatString: 0
		lineageTag: cf76c915-9607-49e9-9cb7-d27767d01c3e
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Año]

		annotation SummarizationSetBy = Automatic

	column 'Mes Nro'
		formatString: 0
		lineageTag: d871160c-00c6-4ce9-8613-da8b7b3ec911
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Mes Nro]

