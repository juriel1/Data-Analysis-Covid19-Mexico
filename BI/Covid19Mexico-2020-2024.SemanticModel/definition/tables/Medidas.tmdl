		lineageTag: 9e8fc736-3d34-411b-9668-fc4ff7fc002f

	measure 'M Total Casos X Comorbilidad' =
			
			SWITCH(
			    TablaBotones[BotonSeleccionado],
			    "ASMA",CALCULATE(COUNTROWS(fact_covid),DIM_Comorbilidades_Respiratorias[ASMA]=1),
			    "CARDIOVASCULAR",CALCULATE(COUNTROWS(fact_covid),DIM_Comorbilidades_de_presion[CARDIOVASCULAR]=1),
			    "DIABETES",CALCULATE(COUNTROWS(fact_covid),DIM_Comorbilidades_de_presion[DIABETES]=1),
			    "EPOC",CALCULATE(COUNTROWS(fact_covid),DIM_Comorbilidades_Respiratorias[EPOC]=1),
			    "HIPERTENSION",CALCULATE(COUNTROWS(fact_covid),DIM_Comorbilidades_de_presion[HIPERTENSION]=1),
			    "INMUNO",CALCULATE(COUNTROWS(fact_covid),DIM_Comorbilidades_de_presion[INMUSUPR]=1),
			    "INTUBADO",CALCULATE(COUNTROWS(fact_covid),DIM_Comorbilidades_Respiratorias[INTUBADO]=1),
			    "NEUMONIA",CALCULATE(COUNTROWS(fact_covid),DIM_Comorbilidades_Respiratorias[NEUMONIA]=1),
			    "OBESIDAD",CALCULATE(COUNTROWS(fact_covid),DIM_Comorbilidades_de_presion[OBESIDAD]=1),
			    "TABAQUISMO",CALCULATE(COUNTROWS(fact_covid),DIM_Comorbilidades_Respiratorias[TABAQUISMO]=1),
			    CALCULATE(COUNTROWS(fact_covid),DIM_Comorbilidades_de_presion[CARDIOVASCULAR]=1)
			)
		formatString: 0
		lineageTag: e4408dda-edf8-4b9a-be77-85ec473e1123

	measure 'M Total Def X Comorbilidad' =
			
			SWITCH(
			    TablaBotones[BotonSeleccionado],
			    "ASMA",CALCULATE(COUNTROWS(fact_covid),DIM_Comorbilidades_Respiratorias[ASMA]=1,NOT ISBLANK(fact_covid[FECHA_DEF_DATE])),
			    "CARDIOVASCULAR",CALCULATE(COUNTROWS(fact_covid),DIM_Comorbilidades_de_presion[CARDIOVASCULAR]=1,NOT ISBLANK(fact_covid[FECHA_DEF_DATE])),
			    "DIABETES",CALCULATE(COUNTROWS(fact_covid),DIM_Comorbilidades_de_presion[DIABETES]=1,NOT ISBLANK(fact_covid[FECHA_DEF_DATE])),
			    "EPOC",CALCULATE(COUNTROWS(fact_covid),DIM_Comorbilidades_Respiratorias[EPOC]=1,NOT ISBLANK(fact_covid[FECHA_DEF_DATE])),
			    "HIPERTENSION",CALCULATE(COUNTROWS(fact_covid),DIM_Comorbilidades_de_presion[HIPERTENSION]=1,NOT ISBLANK(fact_covid[FECHA_DEF_DATE])),
			    "INMUNO",CALCULATE(COUNTROWS(fact_covid),DIM_Comorbilidades_de_presion[INMUSUPR]=1,NOT ISBLANK(fact_covid[FECHA_DEF_DATE])),
			    "INTUBADO",CALCULATE(COUNTROWS(fact_covid),DIM_Comorbilidades_Respiratorias[INTUBADO]=1,NOT ISBLANK(fact_covid[FECHA_DEF_DATE])),
			    "NEUMONIA",CALCULATE(COUNTROWS(fact_covid),DIM_Comorbilidades_Respiratorias[NEUMONIA]=1,NOT ISBLANK(fact_covid[FECHA_DEF_DATE])),
			    "OBESIDAD",CALCULATE(COUNTROWS(fact_covid),DIM_Comorbilidades_de_presion[OBESIDAD]=1,NOT ISBLANK(fact_covid[FECHA_DEF_DATE])),
			    "TABAQUISMO",CALCULATE(COUNTROWS(fact_covid),DIM_Comorbilidades_Respiratorias[TABAQUISMO]=1,NOT ISBLANK(fact_covid[FECHA_DEF_DATE])),
			    CALCULATE(COUNTROWS(fact_covid),DIM_Comorbilidades_de_presion[CARDIOVASCULAR]=1,NOT ISBLANK(fact_covid[FECHA_DEF_DATE]))
			)
		formatString: 0
		lineageTag: de9f84ba-12d0-4699-8057-4e747f085656

	measure 'M Estado max' =
			
			CONCATENATEX(
			    TOPN(
			        1,
			        'Catálogo de ENTIDADES',
			        [M Total Casos],
			        DESC
			    ),
			    'Catálogo de ENTIDADES'[ENTIDAD_FEDERATIVA],
			    ", "
			)
		lineageTag: cf40fc6f-8c64-49f3-bb52-92c4ab32ee8e

	measure 'M Estado min' =
			
			CONCATENATEX(
			    TOPN(
			        1,
			        'Catálogo de ENTIDADES',
			        [M Total Casos],
			        ASC
			    ),
			    'Catálogo de ENTIDADES'[ENTIDAD_FEDERATIVA],
			    ", "
			)
		lineageTag: 29f68198-08a4-47a5-b22c-1c94cb963c98

