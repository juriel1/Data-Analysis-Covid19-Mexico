			    [BotonSeleccionado],
			    "CARDIOVASCULAR", 100,
			    "DIABETES", 500,
			    "Opción C", 1000,
			    0   // Valor por defecto si no hay nada seleccionado
			)
		formatString: 0
		lineageTag: 1d493b0b-43eb-4879-b060-018a55c2003e

	column Categoria
