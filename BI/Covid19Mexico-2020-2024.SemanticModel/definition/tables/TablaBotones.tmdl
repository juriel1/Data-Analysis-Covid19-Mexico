table TablaBotones
	lineageTag: dee5fbac-ac7c-4558-a658-5f6c09a4ede1

	measure BotonSeleccionado = SELECTEDVALUE('TablaBotones'[Categoria], "Cardio Vascular")
		lineageTag: 5d27a4e5-1c73-4077-b63d-f4507c5ffc47

	measure Prueba_Calculo =
			
