				  Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("Lcs7DgMhDEXRvbieIpN/SgOWYingCYY0I/a/jTFWynv03r5DxJpYfqixf7DCAiuMZYfEGKiRGpwd3rxRbVSUpRheHLnkXsTy6imBlBMmg5sDakaLuwdtEi0e/2frAdP8Ph0K9SyF5/zl0DDgt7PmuVlPMMYB", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Categoria = _t, Id = _t]),
